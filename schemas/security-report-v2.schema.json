{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecurityReportFile",
  "description": "Exportable v2 report created only after every batch case is terminal.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "lattice-estimator/security-report"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "parameter_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SecurityReportEntry"
      },
      "minItems": 1
    },
    "version": {
      "type": "integer",
      "const": 2
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "reports"
  ],
  "$defs": {
    "AnalysisModel": {
      "description": "Exact transformation used to reduce a public problem to an estimator problem.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "derived_lwe": {
              "$ref": "#/$defs/LweProblem"
            },
            "kind": {
              "type": "string",
              "const": "coefficient_embedding_v1"
            },
            "scalar_samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "source_ring_samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "version",
            "source_ring_samples",
            "scalar_samples",
            "derived_lwe",
            "warnings"
          ]
        }
      ]
    },
    "AnalysisSettings": {
      "description": "Optional user analysis settings before defaults and problem reductions resolve.",
      "type": "object",
      "properties": {
        "cost_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionCostModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "reduction_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_model": {
          "$ref": "#/$defs/SecurityModel"
        }
      },
      "additionalProperties": false,
      "required": [
        "security_model"
      ]
    },
    "Attack": {
      "description": "Canonical attack identifiers used in scheduling, caching, and reports.",
      "type": "string",
      "enum": [
        "arora_gb",
        "bkw",
        "usvp",
        "bdd",
        "bdd_hybrid",
        "bdd_mitm_hybrid",
        "dual",
        "dual_hybrid",
        "dsd",
        "lattice"
      ]
    },
    "AttackOutcome": {
      "description": "Stable final outcome of one attack in a security report.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "computed"
            },
            "metrics": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/NormalizedMetric"
              },
              "default": {}
            },
            "security_bits": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "security_bits"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "no_finite_estimate"
            },
            "raw_result": true,
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeout"
            },
            "timeout_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "timeout_seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "applicability_rule_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "policy_skipped"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason",
            "applicability_rule_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skipped"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "AttackPreflight": {
      "description": "Scheduling audit trail for one slow attack's fast screen.",
      "type": "object",
      "properties": {
        "attack": {
          "$ref": "#/$defs/Attack"
        },
        "trace": {
          "$ref": "#/$defs/PreflightTrace"
        }
      },
      "additionalProperties": false,
      "required": [
        "attack",
        "trace"
      ]
    },
    "AttackResult": {
      "description": "Final outcome, cache status, and timing for one attack.",
      "type": "object",
      "properties": {
        "attack": {
          "$ref": "#/$defs/Attack"
        },
        "cached": {
          "type": "boolean",
          "default": false
        },
        "outcome": {
          "$ref": "#/$defs/AttackOutcome"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionTiming"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "attack",
        "outcome"
      ]
    },
    "CaseExecutionTiming": {
      "description": "Wall-clock case execution interval excluding queue wait before first start.",
      "type": "object",
      "properties": {
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "started_at"
      ]
    },
    "DurationScope": {
      "description": "Whether a duration belongs to one attack or a shared Sage request group.",
      "type": "string",
      "enum": [
        "attack",
        "request_group"
      ]
    },
    "ErrorDistribution": {
      "description": "Supported error-coefficient distributions.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete_gaussian"
            },
            "standard_deviation": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_deviation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eta": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "centered_binomial"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "eta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_integer"
            },
            "lower": {
              "$ref": "#/$defs/SignedInteger"
            },
            "upper": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        }
      ]
    },
    "ExactDecimal": {
      "description": "A canonical, finite base-10 decimal serialized as a JSON string.",
      "type": "string",
      "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$"
    },
    "ExecutionTiming": {
      "description": "Measured execution duration and optional shared-attack ownership.",
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/DurationScope"
        },
        "shared_attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attack"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "scope"
      ]
    },
    "LweProblem": {
      "description": "Unstructured LWE parameters.",
      "type": "object",
      "properties": {
        "dimension": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "error": {
          "$ref": "#/$defs/ErrorDistribution"
        },
        "modulus": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "samples": {
          "$ref": "#/$defs/SampleCount"
        },
        "secret": {
          "$ref": "#/$defs/SecretDistribution"
        }
      },
      "additionalProperties": false,
      "required": [
        "dimension",
        "modulus",
        "samples",
        "secret",
        "error"
      ]
    },
    "NegacyclicRing": {
      "description": "Negacyclic polynomial ring metadata retained for structured problems.",
      "type": "object",
      "properties": {
        "ciphertext_modulus": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "polynomial_degree": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "polynomial_degree",
        "ciphertext_modulus"
      ]
    },
    "NormalizedMetric": {
      "description": "Scalar diagnostic value safe to persist and expose as JSON.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "decimal"
            },
            "value": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "NtruStructure": {
      "description": "Matrix or circulant interpretation of an NTRU instance.",
      "type": "string",
      "enum": [
        "matrix",
        "circulant"
      ]
    },
    "ParameterCase": {
      "description": "One named parameter choice and its analysis settings inside a scheme.",
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisSettings",
          "default": {
            "security_model": "classical"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "$ref": "#/$defs/Problem"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "problem"
      ]
    },
    "PositiveInteger": {
      "description": "A canonical unsigned decimal integer serialized as a JSON string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "PreflightDecision": {
      "description": "Scheduling decision returned by a slow-attack preflight.",
      "type": "string",
      "enum": [
        "run_exact",
        "skip_exact"
      ]
    },
    "PreflightPrecisionTier": {
      "description": "Arora-GB v6 search tier that completed the threshold decision.",
      "type": "string",
      "enum": [
        "coarse",
        "refined"
      ]
    },
    "PreflightTrace": {
      "description": "Auditable preflight result retained alongside any later exact result.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "calibrated_margin_floor_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "decision": {
              "$ref": "#/$defs/PreflightDecision"
            },
            "effective_margin_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "kind": {
              "type": "string",
              "const": "threshold_screen"
            },
            "metrics": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/NormalizedMetric"
              },
              "default": {}
            },
            "precision_tier": {
              "$ref": "#/$defs/PreflightPrecisionTier"
            },
            "reason": {
              "type": "string"
            },
            "requested_margin_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "required_security_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "threshold_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "timing": {
              "$ref": "#/$defs/ExecutionTiming"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "precision_tier",
            "required_security_bits",
            "requested_margin_bits",
            "calibrated_margin_floor_bits",
            "effective_margin_bits",
            "threshold_bits",
            "reason",
            "timing",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "$ref": "#/$defs/PreflightDecision"
            },
            "effective_margin_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "kind": {
              "type": "string",
              "const": "computed"
            },
            "metrics": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/NormalizedMetric"
              },
              "default": {}
            },
            "security_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "threshold_bits": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "timing": {
              "$ref": "#/$defs/ExecutionTiming"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "security_bits",
            "timing",
            "effective_margin_bits",
            "threshold_bits",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/$defs/PreflightDecision"
            },
            "kind": {
              "type": "string",
              "const": "unknown"
            },
            "raw_result": true,
            "reason": {
              "type": "string"
            },
            "timing": {
              "$ref": "#/$defs/ExecutionTiming"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason",
            "timing",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/$defs/PreflightDecision"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "type": "string"
            },
            "timing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ExecutionTiming"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "message",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "not_run"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "reason"
          ]
        }
      ]
    },
    "Problem": {
      "description": "Public problem variants accepted in parameter-set files and the UI.",
      "oneOf": [
        {
          "description": "Unstructured LWE parameters.",
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "lwe"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "description": "Ring-LWE parameters expressed using polynomial length and ring samples.",
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "rlwe"
            },
            "negacyclic_ring": {
              "$ref": "#/$defs/NegacyclicRing"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "negacyclic_ring",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "description": "GLWE parameters with polynomial length and vector dimension kept distinct.",
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "glwe"
            },
            "negacyclic_ring": {
              "$ref": "#/$defs/NegacyclicRing"
            },
            "samples": {
              "$ref": "#/$defs/SampleCount"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "negacyclic_ring",
            "dimension",
            "samples",
            "secret",
            "error"
          ]
        },
        {
          "description": "NTRU parameters prior to reduction to the estimator's internal model.",
          "type": "object",
          "properties": {
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "error": {
              "$ref": "#/$defs/ErrorDistribution"
            },
            "kind": {
              "type": "string",
              "const": "ntru"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "secret": {
              "$ref": "#/$defs/SecretDistribution"
            },
            "structure": {
              "$ref": "#/$defs/NtruStructure"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "secret",
            "error",
            "structure"
          ]
        },
        {
          "description": "Short-integer-solution instance parameters.",
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "dimension": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "sis"
            },
            "length_bound": {
              "$ref": "#/$defs/ExactDecimal"
            },
            "modulus": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "norm": {
              "$ref": "#/$defs/SisNorm"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dimension",
            "modulus",
            "columns",
            "length_bound",
            "norm"
          ]
        }
      ]
    },
    "Provenance": {
      "description": "Estimator and analysis versions required to reproduce a report entry.",
      "type": "object",
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "analysis_model": {
          "$ref": "#/$defs/AnalysisModel"
        },
        "created_at": {
          "type": "string"
        },
        "estimator_commit": {
          "type": "string"
        },
        "resolved_analysis": {
          "$ref": "#/$defs/ResolvedAnalysisSettings"
        },
        "sage_version": {
          "type": "string"
        },
        "worker_image": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "estimator_commit",
        "sage_version",
        "adapter_version",
        "worker_image",
        "analysis_model",
        "resolved_analysis",
        "created_at"
      ]
    },
    "ReductionCostModel": {
      "description": "Lattice-reduction cost model selected for upstream estimation.",
      "type": "string",
      "enum": [
        "BDGL16",
        "LaaMosPol14"
      ]
    },
    "ReductionModel": {
      "description": "User-facing pairing of reduction cost and shape assumptions.",
      "type": "string",
      "enum": [
        "coefficient_embedding_v1"
      ]
    },
    "ResolvedAnalysisSettings": {
      "description": "Concrete cost and classical/quantum settings sent upstream.",
      "type": "object",
      "properties": {
        "cost_model": {
          "$ref": "#/$defs/ReductionCostModel"
        },
        "reduction_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReductionModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "security_model": {
          "$ref": "#/$defs/SecurityModel"
        }
      },
      "additionalProperties": false,
      "required": [
        "security_model",
        "cost_model"
      ]
    },
    "SampleCount": {
      "description": "Finite or estimator-defined unlimited sample availability.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "finite"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "count"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unlimited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SecretDistribution": {
      "description": "Supported secret-coefficient distributions.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_ternary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Independent coefficients with P(-1)=1/4, P(0)=1/2, and P(1)=1/4.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sparse_ternary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hamming_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "fixed_weight_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hamming_weight"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed_weight_ternary"
            },
            "negative_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "positive_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "positive_weight",
            "negative_weight"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discrete_gaussian"
            },
            "standard_deviation": {
              "$ref": "#/$defs/ExactDecimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "standard_deviation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "eta": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "centered_binomial"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "eta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "uniform_integer"
            },
            "lower": {
              "$ref": "#/$defs/SignedInteger"
            },
            "upper": {
              "$ref": "#/$defs/SignedInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper"
          ]
        }
      ]
    },
    "SecurityModel": {
      "description": "Security interpretation attached to a parameter case.",
      "type": "string",
      "enum": [
        "classical",
        "quantum"
      ]
    },
    "SecurityReportEntry": {
      "description": "Progressive or final analysis state for one parameter case.",
      "type": "object",
      "properties": {
        "attacks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AttackResult"
          }
        },
        "case": {
          "$ref": "#/$defs/ParameterCase"
        },
        "execution": {
          "$ref": "#/$defs/CaseExecutionTiming"
        },
        "preflights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttackPreflight"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "request_hash": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/SecuritySummary"
        }
      },
      "additionalProperties": false,
      "required": [
        "case",
        "execution",
        "request_hash",
        "provenance",
        "summary",
        "preflights"
      ]
    },
    "SecuritySummary": {
      "description": "Case-level minimum-security conclusion derived only from approved outcomes.",
      "type": "object",
      "properties": {
        "best_attack": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attack"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "fast_estimate": {
          "type": "boolean",
          "default": false
        },
        "security_bits": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "complete"
      ]
    },
    "SignedInteger": {
      "description": "A canonical signed decimal integer serialized as a JSON string.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "SisNorm": {
      "description": "Norm used to interpret the SIS solution bound.",
      "type": "string",
      "enum": [
        "l2",
        "l_infinity"
      ]
    }
  }
}
