# Maximum Sage worker processes that estimator-api runs at the same time.
LATTICE_ESTIMATOR_API_CONCURRENCY=3

# Maximum parameter cases that the Web scheduler processes at the same time.
LATTICE_ESTIMATOR_WEB_CASE_CONCURRENCY=2

# Maximum concurrent HTTP estimation requests sent by Web across all running cases.
# Keeping this at or below API_CONCURRENCY avoids building a queue in estimator-api.
LATTICE_ESTIMATOR_WEB_ESTIMATOR_CONCURRENCY=3

LATTICE_ESTIMATOR_WEB_HOST=127.0.0.1
LATTICE_ESTIMATOR_WEB_PORT=8080
LATTICE_ESTIMATOR_WEB_API_TOKEN=
